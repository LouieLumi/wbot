{
  "manifest_version": 3,
  "name": "Nila · Gemini 网页生图",
  "version": "1.1.1",
  "description": "将 Nila 的图片任务发送到专用 Gemini 标签页。",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["http://127.0.0.1/*", "https://gemini.google.com/*"],
  "background": {"service_worker": "worker.js", "type": "module"},
  "content_scripts": [{"matches": ["https://gemini.google.com/*"], "js": ["page.js"], "run_at": "document_idle"}],
  "action": {"default_title": "打开 Nila 生图页面"}
}

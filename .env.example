# npm run setup generates a private .env with a random API token.
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=3100
BRIDGE_API_TOKEN=
BRIDGE_DB=data/bridge.sqlite

# Start with mock; set android_hook only after configuring your own phone module.
WECHAT_DEVICE_MODE=mock
WECHAT_DEVICE_SERIAL=YOUR_ANDROID_SERIAL
ADB_SERVER_PORT=5038
WECHAT_PROFILE=config/wechat-profile.json
WECHAT_HOOK_BASE_URL=http://127.0.0.1:3151
WECHAT_HOOK_TOKEN=
WECHAT_ADMIN_ID=
WECHAT_ALLOWED_CHAT_IDS=[]
WECHAT_AUTO_REPLY=false
WECHAT_REPLY_MODE=verified_mention
WECHAT_BOT_NAME=Nila
WECHAT_POLL_MS=3000

# ollama or hermes; all model endpoints must be local.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_TIMEOUT_MS=120000
HERMES_API_BASE_URL=
HERMES_API_KEY=
HERMES_MODEL=gemini-3.8-flash-high
HERMES_WEB_SEARCH=false

# proxy or gemini_web; browser mode needs the generated extension setup values.
IMAGE_PROVIDER=proxy
IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_WEB_PORT=3152
GEMINI_WEB_TOKEN=
GEMINI_WEB_EXTENSION_ID=

# Optional legacy OpenClaw adapter, disabled until explicitly configured.
OPENCLAW_BASE_URL=http://127.0.0.1:18789
OPENCLAW_TOKEN=
OPENCLAW_AGENT_ID=wechat-bot
OPENCLAW_ENDPOINT_VERIFIED=false
OPENCLAW_AGENT_RESTRICTED=false

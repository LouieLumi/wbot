{
  "name": "wbot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env apps/server/src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/apps/server/src/main.js",
    "test": "tsx --test tests/*.test.ts",
    "test:android": "node scripts/test-android-text-ledger.mjs",
    "check": "npm run build && npm test && npm run test:android",
    "device:probe": ".runtime/venv/bin/python scripts/device-agent.py probe",
    "admin": "node --env-file=.env scripts/open-admin.mjs",
    "setup": "node scripts/init-env.mjs"
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/websocket": "^11.2.0",
    "@mozilla/readability": "^0.6.0",
    "fastify": "^5.6.0",
    "ipaddr.js": "^2.5.0",
    "jsdom": "^27.0.1",
    "ws": "^8.18.3",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.18.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "description": "Local WeChat group bot bridge with member memory, admin console and Gemini image sessions"
}
